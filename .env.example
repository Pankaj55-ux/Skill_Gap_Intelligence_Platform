NODE_ENV=development
APP_NAME=sgip-api
API_PREFIX=/api/v1
PORT=5000

# PostgreSQL connection used by Prisma.
# Local Docker default:
DATABASE_URL=postgresql://postgres:Vanita_bhoj9084@db.fvojuzuconjmuevqiuru.supabase.co:5432/postgres
# Supabase example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public&sslmode=require
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=12
UPLOADS_DIR=uploads
SHUTDOWN_TIMEOUT_MS=10000
GEMINI_API_KEY=

# Frontend API base URL. In local Vite dev, the default /api/v1 is proxied to http://localhost:5000.
VITE_API_URL=/api/v1
# VITE_API_BASE_URL=http://localhost:5000/api/v1
