model InterviewAnswer {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  resumeId       String?              @db.Uuid
  question       String
  answer         String
  expectedTopics Json                 @default("[]") @db.JsonB
  answerType     String               @default("TEXT") @db.VarChar(40)
  submittedAt    DateTime             @default(now()) @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  createdBy      String?              @db.Uuid
  updatedBy      String?              @db.Uuid
  status         RecordStatus         @default(COMPLETED)
  deletedAt      DateTime?            @db.Timestamptz(3)
  metadata       Json?                @db.JsonB
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?              @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  evaluation     InterviewEvaluation?
  liveTurn       InterviewTurn?

  @@index([userId])
  @@index([resumeId])
  @@index([status])
  @@index([createdAt])
}

model InterviewEvaluation {
  id                 String          @id @default(uuid()) @db.Uuid
  answerId           String          @unique @db.Uuid
  score              Decimal         @db.Decimal(5, 2)
  strengths          Json            @db.JsonB
  weaknesses         Json            @db.JsonB
  missingConcepts    Json            @db.JsonB
  communicationScore Decimal         @db.Decimal(5, 2)
  technicalScore     Decimal         @db.Decimal(5, 2)
  confidenceScore    Decimal         @db.Decimal(5, 2)
  improvementPlan    Json            @db.JsonB
  summary            String
  aiModel            String          @db.VarChar(120)
  promptVersion      String          @db.VarChar(60)
  executionTimeMs    Int
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  createdBy          String?         @db.Uuid
  updatedBy          String?         @db.Uuid
  status             RecordStatus    @default(COMPLETED)
  deletedAt          DateTime?       @db.Timestamptz(3)
  metadata           Json?           @db.JsonB
  answer             InterviewAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
  @@index([status])
  @@index([createdAt])
}

model InterviewSession {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  resumeId        String?         @db.Uuid
  targetRole      String          @db.VarChar(180)
  status          String          @default("ACTIVE") @db.VarChar(40)
  durationMinutes Int             @default(30)
  startedAt       DateTime        @default(now()) @db.Timestamptz(3)
  pausedAt        DateTime?       @db.Timestamptz(3)
  resumedAt       DateTime?       @db.Timestamptz(3)
  endedAt         DateTime?       @db.Timestamptz(3)
  elapsedSeconds  Int             @default(0)
  expectedTopics  Json            @default("[]") @db.JsonB
  finalReport     Json?           @db.JsonB
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  createdBy       String?         @db.Uuid
  updatedBy       String?         @db.Uuid
  recordStatus    RecordStatus    @default(ACTIVE)
  deletedAt       DateTime?       @db.Timestamptz(3)
  metadata        Json?           @db.JsonB
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  turns           InterviewTurn[]

  @@index([userId])
  @@index([resumeId])
  @@index([status])
  @@index([recordStatus])
  @@index([createdAt])
}

model InterviewTurn {
  id                String           @id @default(uuid()) @db.Uuid
  sessionId         String           @db.Uuid
  interviewAnswerId String?          @unique @db.Uuid
  turnNumber        Int
  question          String
  expectedTopics    Json             @default("[]") @db.JsonB
  questionAudio     Json?            @db.JsonB
  answerText        String?
  answerMode        String?          @db.VarChar(40)
  answerAudio       Json?            @db.JsonB
  transcript        String?
  askedAt           DateTime         @default(now()) @db.Timestamptz(3)
  answeredAt        DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  createdBy         String?          @db.Uuid
  updatedBy         String?          @db.Uuid
  status            RecordStatus     @default(ACTIVE)
  deletedAt         DateTime?        @db.Timestamptz(3)
  metadata          Json?            @db.JsonB
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  interviewAnswer   InterviewAnswer? @relation(fields: [interviewAnswerId], references: [id], onDelete: SetNull)

  @@unique([sessionId, turnNumber])
  @@index([sessionId])
  @@index([interviewAnswerId])
  @@index([status])
  @@index([createdAt])
}

model ProgressLog {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @db.Uuid
  roadmapId            String       @db.Uuid
  roadmapItemId        String       @db.VarChar(80)
  skillId              String?      @db.Uuid
  completed            Boolean      @default(false)
  completionPercentage Int          @default(0)
  completedAt          DateTime?    @db.Timestamptz(3)
  notes                String?
  progressPercent      Int          @default(0)
  note                 String?
  loggedAt             DateTime     @default(now()) @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  createdBy            String?      @db.Uuid
  updatedBy            String?      @db.Uuid
  status               RecordStatus @default(ACTIVE)
  deletedAt            DateTime?    @db.Timestamptz(3)
  metadata             Json?        @db.JsonB
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap              Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill                Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([userId, roadmapId, roadmapItemId])
  @@index([userId])
  @@index([roadmapId])
  @@index([roadmapItemId])
  @@index([skillId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, roadmapId, status, deletedAt, loggedAt])
}

model AuditEvent {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @db.Uuid
  actorId    String?      @db.Uuid
  action     String       @db.VarChar(120)
  entityType String       @db.VarChar(120)
  entityId   String?      @db.Uuid
  payload    Json?        @db.JsonB
  ipAddress  String?      @db.VarChar(64)
  userAgent  String?      @db.VarChar(512)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  createdBy  String?      @db.Uuid
  updatedBy  String?      @db.Uuid
  status     RecordStatus @default(ACTIVE)
  deletedAt  DateTime?    @db.Timestamptz(3)
  metadata   Json?        @db.JsonB
  user       User?        @relation("AuditSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor      User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([actorId, createdAt])
}
